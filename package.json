require("dotenv").config();
const {
  Client,
  GatewayIntentBits,
  EmbedBuilder
} = require("discord.js");

const client = new Client({
  intents: [
    GatewayIntentBits.Guilds,
    GatewayIntentBits.GuildMessages,
    GatewayIntentBits.MessageContent
  ]
});

// ID do canal
const CHANNEL_ID = "1532295157897232464";

client.once("ready", async () => {
  console.log(`${client.user.tag} está online!`);

  const channel = await client.channels.fetch(CHANNEL_ID);

  if (!channel) return console.log("Canal não encontrado.");

  const embed = new EmbedBuilder()
    .setColor("#0099ff")
    .setTitle("🚀 Nova atualização disponível!")
    .setDescription("Confira a versão mais recente abaixo.")
    .addFields(
      {
  name: "📥 Download",
  value: "https://delta.filenetwork.vip/android.html"
},
{
  name: "📝 Changelog",
  value: "• Correções de bugs\n• Melhor desempenho\n• Novos recursos"
}
    )
    .setTimestamp()
    .setFooter({
      text: "Roblox Scripts Bot"
    });

  await channel.send({
    content: "<@&1532297126120263752>",
    embeds: [embed]
  });
});

client.on("messageCreate", async (message) => {
  if (message.author.bot) return;

  if (message.content === "!teste") {
    const embed = new EmbedBuilder()
      .setColor("#0099ff")
      .setTitle("🚀 Nova atualização disponível!")
      .setDescription("Confira a versão mais recente abaixo.")
      .addFields(
        {
          name: "📥 Download",
          value: value: "https://delta.filenetwork.vip/android.html"
        },
        {
          name: "📝 Changelog",
          value:
            "• Correções de bugs\n• Melhor desempenho\n• Novos recursos"
        }
      )
      .setTimestamp();

    await message.channel.send({
      content: "<@&1532297126120263752>",
      embeds: [embed]
    });
  }
});

client.login(process.env.TOKEN);
